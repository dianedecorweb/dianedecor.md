generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MessageStatus {
  NEW
  READ
  CONTACTED
  ARCHIVED
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String    @unique
  description String?
  coverImage  String?
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([order])
}

model Project {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String    @unique
  clientNames      String?
  categoryId       String    @db.ObjectId
  category         Category  @relation(fields: [categoryId], references: [id])
  eventDate        DateTime?
  location         String?
  shortDescription String
  description      String
  coverImage       String
  // Sala goală, înainte de decor. Cu ea, pagina proiectului arată comparația.
  beforeImage      String?
  images           String[]
  tags             String[]
  featured         Boolean   @default(false)
  published        Boolean   @default(true)
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([categoryId, published])
  @@index([featured, published])
}

model Service {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String   @unique
  shortDescription String
  description      String
  icon             String
  features         String[]
  coverImage       String?
  priceFrom        Int?
  order            Int      @default(0)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  authorName String
  eventType  String
  content    String
  rating     Int      @default(5)
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  phone      String
  email      String?
  eventType  String
  eventDate  DateTime?
  location   String?
  guestCount Int?
  message    String
  status     MessageStatus @default(NEW)
  createdAt  DateTime      @default(now())

  // Mesajul din Telegram care anunță cererea. Îl păstrăm ca să putem edita
  // butoanele de acolo când starea se schimbă din panou, nu doar invers.
  telegramMessageId Int?

  // De unde a pornit cererea: „fereastra" (fereastra de la intrare), „buton"
  // (butonul flotant), „chirie" (catalogul de chirie) sau „site".
  source String?

  // Limba paginii: „ru" pentru cererile de pe /ru, „ro" sau gol pentru restul.
  locale String?

  // Doar pentru studio, nu se văd nicăieri pe site.
  note       String?
  followUpAt DateTime?

  @@index([status, createdAt])
}

/// Câte apăsări pe telefon și pe Instagram, pe zi și pe locul de unde au venit.
/// Un rând pe combinație, incrementat; nu ține nimic despre vizitator.
model ChannelClick {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  day     String
  channel String
  source  String
  count   Int    @default(0)

  @@unique([day, channel, source])
}

/// O zi în care studioul e deja rezervat. Ora e mereu miezul nopții UTC.
model BookedDate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime @unique
  note      String?
  createdAt DateTime @default(now())
}

/// Un obiect din catalogul de chirie: arcadă, suport, vază.
model RentalItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String
  image       String
  priceFrom   Int?
  priceUnit   String   @default("zi")
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}
